root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ktlint_code_style = ktlint_official
ij_kotlin_imports_layout = java.**,javax.**,kotlin.**,|,*,|,name.roqia.**,^

[*.gradle]
indent_size = 4

[*.{md,patch}]
trim_trailing_whitespace = false
