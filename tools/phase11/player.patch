+package com.doublesymmetry.trackplayer.service;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.provider.Settings;
+
+/** Owned by the native playback service, independent of React and JS timers. */
+public final class RoqiaSleepTimer {
+  private static final Handler handler = new Handler(Looper.getMainLooper());
+  private static Context context;
+  private static Runnable pause;
+  private static long elapsedDeadline;
+  private static final Runnable tick = () -> check();
+  private static SharedPreferences prefs(Context c) { return c.getSharedPreferences("roqia-sleep", 0); }
+  private static int boot(Context c) { return Settings.Global.getInt(c.getContentResolver(), Settings.Global.BOOT_COUNT, -1); }
+  private static void mainThread() {
+    if (Looper.myLooper() != Looper.getMainLooper()) throw new IllegalStateException("sleep_requires_main_thread");
+  }
+  private static long remaining(Context c) {
+    SharedPreferences p = prefs(c);
+    if (p.getLong("wall", 0) == 0) return 0;
+    return p.getInt("boot", -2) == boot(c)
+      ? p.getLong("elapsed", 0) - SystemClock.elapsedRealtime()
+      : Math.min(4L * 3600000, p.getLong("wall", 0) - System.currentTimeMillis());
+  }
+  public static void attach(Context c, Runnable stop) {
+    mainThread(); context = c.getApplicationContext(); pause = stop;
+    long left = remaining(c);
+    elapsedDeadline = prefs(c).getLong("wall", 0) == 0 ? 0 : SystemClock.elapsedRealtime() + Math.max(0, left);
+    check();
+  }
+  public static void detach() {
+    mainThread(); handler.removeCallbacks(tick); pause = null; context = null; elapsedDeadline = 0;
+  }
+  public static long set(Context c, long durationMs) {
+    mainThread();
+    if (durationMs < 0 || durationMs > 4L * 3600000) throw new IllegalArgumentException("invalid_sleep_duration");
+    if (durationMs > 0 && pause == null) throw new IllegalStateException("player_not_initialized");
+    long wall = durationMs == 0 ? 0 : System.currentTimeMillis() + durationMs;
+    long elapsed = durationMs == 0 ? 0 : SystemClock.elapsedRealtime() + durationMs;
+    if (!prefs(c).edit().putLong("wall", wall).putLong("elapsed", elapsed).putInt("boot", boot(c)).commit())
+      throw new IllegalStateException("sleep_save_failed");
+    elapsedDeadline = elapsed;
+    check();
+    return wall;
+  }
+  public static long get(Context c) {
+    mainThread(); if (context != null) check();
+    long left = remaining(c);
+    return left > 0 ? System.currentTimeMillis() + left : 0;
+  }
+  private static void check() {
+    handler.removeCallbacks(tick);
+    if (context == null || pause == null || elapsedDeadline == 0) return;
+    long left = elapsedDeadline - SystemClock.elapsedRealtime();
+    if (left <= 0) {
+      // Pause first even if storage fails. No automatic playback restart on expiry.
+      pause.run();
+      prefs(context).edit().remove("wall").remove("elapsed").remove("boot").commit();
+      elapsedDeadline = 0;
+      android.util.Log.i("RoqiaSleep", "expired_native_pause");
+    } else handler.postDelayed(tick, Math.min(left, 1000));
+  }
+}
