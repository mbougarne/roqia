+package com.eko
+
+import java.io.File
+import java.io.FileOutputStream
+import java.net.HttpURLConnection
+import java.util.Properties
+
+/** Roqia 4.6.3 extension: on-disk length + synced entity metadata, never a stale progress offset. */
+internal class RoqiaResume(private val destination: String, private val url: String) {
+  companion object {
+    private val locks = java.util.concurrent.ConcurrentHashMap<String, Any>()
+    fun lock(path: String): Any = locks.getOrPut(path) { Any() }
+  }
+  private val file = File(destination)
+  private val sidecar = File(destination + ".resume")
+  private val saved = Properties().apply {
+    try { sidecar.inputStream().use { load(it) } } catch (_: Exception) { clear() }
+  }
+  var total: Long = saved.getProperty("total")?.toLongOrNull() ?: -1
+  fun validator(): String = saved.getProperty("validator", "")
+  fun offset(): Long = if (saved.getProperty("url") == url && validator().isNotEmpty() &&
+    file.isFile && (total < 0 || file.length() <= total)) file.length() else 0
+  fun reset() {
+    file.parentFile?.mkdirs()
+    FileOutputStream(file).use { it.fd.sync() }
+    sidecar.delete()
+    saved.clear()
+    total = -1
+  }
+  private fun entity(c: HttpURLConnection): String {
+    val etag = c.getHeaderField("ETag")
+    return if (!etag.isNullOrBlank() && !etag.startsWith("W/")) etag
+      else c.getHeaderField("Last-Modified") ?: ""
+  }
+  // null means safe to consume. A reason means replace bytes or retry from zero.
+  fun response(c: HttpURLConnection, offset: Long): String? {
+    val code = c.responseCode
+    if (code == 416) {
+      val length = Regex("bytes \\*/([0-9]+)").matchEntire(c.getHeaderField("Content-Range") ?: "")
+        ?.groupValues?.get(1)?.toLongOrNull()
+      return if (offset > 0 && length == offset && total == offset &&
+        (entity(c).isEmpty() || entity(c) == validator())) null else "range_not_satisfiable"
+    }
+    if (code != 200 && code != 206) return null
+    val encoding = c.getHeaderField("Content-Encoding")
+    if (!encoding.isNullOrBlank() && encoding != "identity") throw java.io.IOException("encoded_response")
+    var length = c.contentLengthLong
+    if (code == 206) {
+      val range = Regex("bytes ([0-9]+)-([0-9]+)/([0-9]+)")
+        .matchEntire(c.getHeaderField("Content-Range") ?: "") ?: return "range_invalid"
+      val start = range.groupValues[1].toLongOrNull() ?: return "range_invalid"
+      val end = range.groupValues[2].toLongOrNull() ?: return "range_invalid"
+      val full = range.groupValues[3].toLongOrNull() ?: return "range_invalid"
+      if (start != offset || end < start || full <= end ||
+        (length >= 0 && length != end - start + 1)) return "range_invalid"
+      if (offset > 0 && (entity(c) != validator() || (total >= 0 && total != full))) return "entity_changed"
+      length = full
+    }
+    total = length
+    saved.setProperty("url", url)
+    saved.setProperty("validator", entity(c))
+    saved.setProperty("total", length.toString())
+    file.parentFile?.mkdirs()
+    val temporary = File(destination + ".resume.tmp")
+    FileOutputStream(temporary).use { saved.store(it, "Roqia resume entity"); it.fd.sync() }
+    android.system.Os.rename(temporary.path, sidecar.path)
+    val fd = android.system.Os.open(sidecar.parent, android.system.OsConstants.O_RDONLY, 0)
+    try { android.system.Os.fsync(fd) } finally { android.system.Os.close(fd) }
+    return if (offset > 0 && code == 200) "server_restarted" else null
+  }
+}
