<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/roqia_launch_background" />
    <item android:gravity="top|right" android:width="180dp" android:height="180dp"><rotate android:fromDegrees="90" android:toDegrees="90" android:drawable="@drawable/roqia_launch_corner" /></item>
    <item android:gravity="bottom|left" android:width="180dp" android:height="180dp"><rotate android:fromDegrees="270" android:toDegrees="270" android:drawable="@drawable/roqia_launch_corner" /></item>
    <item android:gravity="center" android:width="288dp" android:height="288dp" android:drawable="@drawable/roqia_launch_mark" />
</layer-list>
