{
  "name": "app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "gen:keystore": "keytool -genkey -v -keystore roqia.keystore -alias roqia-key -keyalg RSA -keysize 2048 -validity 10000",
    "build:release": "yarn gen:keystore && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.16.3",
    "react": "19.2.4",
    "react-native": "0.84.1",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/runtime": "^7.29.2",
    "@react-native/babel-preset": "0.84.1",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/metro-config": "0.84.1",
    "@tsconfig/react-native": "^3.0.9",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^30.3.0",
    "eslint": "^10.2.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
